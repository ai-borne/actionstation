{
  "name": "actionstation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "browserslist": [
    "Chrome >= 92",
    "Firefox >= 90",
    "Safari >= 15.4",
    "Edge >= 92"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "build:quick": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:strict": "eslint . --max-warnings 0",
    "lint:ci": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:high": "npm audit --audit-level=high",
    "guard:env-leak": "bash scripts/ci/guard-env-leak.sh",
    "guard:api-key-isolation": "bash scripts/ci/guard-api-key-isolation.sh",
    "guard:secret-scan": "bash scripts/ci/guard-secret-scan.sh",
    "guard:secrets-staged": "bash scripts/ci/guard-secrets-staged.sh",
    "lint:staged": "bash scripts/ci/lint-staged.sh",
    "lighthouse:ci:local": "npx --yes @lhci/cli@latest autorun",
    "ci:gh-parity": "bash scripts/ci/run-gh-ci-parity.sh",
    "precommit:local": "npm run guard:env-leak && npm run guard:api-key-isolation && npm run guard:secrets-staged && npm run lint:staged",
    "prepush:local": "npm run ci:gh-parity",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:ci": "npm run typecheck && npm run lint && npm run test && npm run build:quick",
    "security-check": "echo 'Scanning for .env files...' && (ls .env .env.local 2>/dev/null && echo 'WARNING: Local .env files found. Ensure they are in .gitignore.' || echo 'No .env files found in root.') && echo 'Ready for CI scan.'",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.40.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.64.2",
    "@tiptap/extension-file-handler": "^3.20.0",
    "@tiptap/extension-highlight": "^3.20.4",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/extension-table-cell": "^3.20.0",
    "@tiptap/extension-table-header": "^3.20.0",
    "@tiptap/extension-table-row": "^3.20.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@tiptap/suggestion": "^3.19.0",
    "@xyflow/react": "^12.4.0",
    "clsx": "^2.1.1",
    "firebase": "^11.2.0",
    "idb": "^8.0.3",
    "mammoth": "^1.11.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "pdfjs-dist": "^5.4.624",
    "posthog-js": "^1.356.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.2.1",
    "unified": "^11.0.5",
    "web-vitals": "^5.1.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lighthouse": "^13.0.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.12",
    "lodash": "^4.17.25",
    "lodash-es": "^4.17.25",
    "serialize-javascript": "^7.0.5",
    "picomatch": "^2.3.2",
    "yaml": "^2.8.3"
  }
}
